{
  "name": "popsub",
  "version": "0.1.0",
  "description": "PopSub client for browsers and Node.js 22+: reconnects, resubscribes without gaps, deduplicates and acknowledges, on the global WebSocket.",
  "keywords": [
    "popsub",
    "pubsub",
    "websocket",
    "client"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soumyadepp/popsub.git",
    "directory": "clients/typescript"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/driver.*"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepack": "npm run build",
    "scenarios": "npm run build && cd ../.. && target/debug/popsub-scenarios --driver \"node clients/typescript/dist/driver.js\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
