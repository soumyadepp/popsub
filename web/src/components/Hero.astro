---
/**
 * Replaces Starlight's hero on the home page: the headline, tagline and actions on the left,
 * and a terminal with real output from the Get started steps on the right.
 */
import { LinkButton } from "@astrojs/starlight/components";
import TerminalDemo from "./TerminalDemo.astro";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const pullCommand = "docker pull ghcr.io/soumyadepp/popsub:0.2";
---

<section class="hero">
  <div class="copy">
    <p class="eyebrow"><span class="spark"></span>Open source · Rust · Apache-2.0</p>
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="tagline" set:html={tagline} />}
    <div class="actions">
      {
        actions.map(({ icon, link: href, text, variant }) => (
          <LinkButton {href} {variant} icon={icon?.name}>
            {text}
          </LinkButton>
        ))
      }
    </div>
    <div class="chip">
      <code><span aria-hidden="true">$ </span>{pullCommand}</code>
      <button type="button" class="copy-btn" data-copy={pullCommand} aria-label="Copy the command">
        <svg class="icon-copy" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
        <svg class="icon-done" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
        <span class="copied" role="status"></span>
      </button>
    </div>
  </div>
  <div class="stage">
    <TerminalDemo />
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-btn[data-copy]").forEach((button) => {
    const status = button.querySelector<HTMLElement>(".copied");
    let timer: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        if (status) status.textContent = "Copied";
        button.classList.add("done");
        clearTimeout(timer);
        timer = setTimeout(() => {
          button.classList.remove("done");
          if (status) status.textContent = "";
        }, 1600);
      } catch {
        if (status) status.textContent = "Copy failed";
      }
    });
  });
</script>

<style>
  .hero {
    display: grid;
    gap: 3rem;
    align-items: center;
    padding: 2rem 0 3rem;
  }
  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: 1fr 1.1fr;
      padding: 4rem 0 4.5rem;
    }
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.3rem 0.8rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 35%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
    color: var(--sl-color-accent-high);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .spark {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--sl-color-accent);
    box-shadow: 0 0 0.6rem var(--sl-color-accent);
  }
  h1 {
    margin: 1.25rem 0 0;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 750;
    color: var(--sl-color-white);
  }
  h1 :global(span) {
    background: linear-gradient(100deg, var(--sl-color-accent) 10%, #f6b26b 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .tagline {
    margin: 1.25rem 0 0;
    max-width: 34rem;
    font-size: var(--sl-text-lg);
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 2rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
    margin-top: 1.75rem;
    padding: 0.4rem 0.45rem 0.4rem 0.9rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.6rem;
    background: var(--sl-color-gray-6);
  }
  .chip code {
    overflow-x: auto;
    white-space: nowrap;
    padding: 0;
    background: none;
    border: 0;
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
  }
  .chip code span {
    color: var(--sl-color-accent);
    user-select: none;
  }
  .copy-btn {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.45rem;
    background: var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .copy-btn:hover,
  .copy-btn:focus-visible {
    color: var(--sl-color-white);
    border-color: var(--sl-color-accent);
  }
  .copy-btn svg {
    grid-area: 1 / 1;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon-done,
  .copy-btn.done .icon-copy {
    display: none;
  }
  .copy-btn.done .icon-done {
    display: block;
    color: var(--sl-color-accent);
  }
  .copied {
    position: absolute;
    bottom: calc(100% + 0.4rem);
    right: 0;
    padding: 0.15rem 0.45rem;
    border-radius: 0.35rem;
    background: var(--sl-color-gray-1);
    color: var(--sl-color-black);
    font-size: var(--sl-text-xs);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }
  .copy-btn.done .copied {
    opacity: 1;
  }
  .stage {
    min-width: 0;
  }
</style>
