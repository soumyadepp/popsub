---
/**
 * Replaces Starlight's hero on the home page: the headline, tagline and actions on the left,
 * and a terminal with real output from the Get started steps on the right.
 */
import { LinkButton } from "@astrojs/starlight/components";
import TerminalDemo from "./TerminalDemo.astro";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const pullCommand = "docker pull ghcr.io/soumyadepp/popsub:0.2";
---

<section class="hero">
  <div class="copy">
    <div class="top">
      <div>
        <p class="eyebrow"><span class="tag">0.2</span>Open source, written in Rust, Apache-2.0</p>
        <h1 id="_top" data-page-title set:html={title} />
      </div>
      <div>
        {tagline && <p class="tagline" set:html={tagline} />}
        <div class="actions">
          {
            actions.map(({ icon, link: href, text, variant }) => (
              <LinkButton {href} {variant} icon={icon?.name}>
                {text}
              </LinkButton>
            ))
          }
        </div>
        <div class="chip">
          <code><span aria-hidden="true">$ </span>{pullCommand}</code>
          <button type="button" class="copy-btn" data-copy={pullCommand} aria-label="Copy the command">
            <svg class="icon-copy" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
            <svg class="icon-done" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
            <span class="copied" role="status"></span>
          </button>
        </div>
      </div>
    </div>
  </div>
  <div class="stage">
    <div class="stage-inner">
      <TerminalDemo />
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-btn[data-copy]").forEach((button) => {
    const status = button.querySelector<HTMLElement>(".copied");
    let timer: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        if (status) status.textContent = "Copied";
        button.classList.add("done");
        clearTimeout(timer);
        timer = setTimeout(() => {
          button.classList.remove("done");
          if (status) status.textContent = "";
        }, 1600);
      } catch {
        if (status) status.textContent = "Copy failed";
      }
    });
  });
</script>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    padding: 2.5rem 0 1rem;
  }
  @media (min-width: 60rem) {
    .hero {
      padding: 4.5rem 0 1.5rem;
    }
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    padding: 0.22rem 0.7rem 0.22rem 0.25rem;
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius);
    background: var(--pop-panel);
    color: var(--pop-text);
    font-size: var(--sl-text-xs);
    font-weight: 500;
  }
  .tag {
    border-radius: 7px;
    background: var(--pop-bg);
    box-shadow: 0 0 0 1px var(--pop-border);
    padding: 0.05rem 0.45rem;
    color: var(--pop-muted);
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
  }
  .top {
    display: grid;
    gap: 1.75rem;
    align-items: end;
  }
  @media (min-width: 60rem) {
    .top {
      grid-template-columns: 1.35fr 1fr;
      gap: 4rem;
    }
  }
  h1 {
    margin: 1.5rem 0 0;
    color: var(--pop-ink);
    font-family: var(--pop-font-display);
    font-size: clamp(2.6rem, 6.2vw, 4.75rem);
    font-weight: 450;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-wrap: balance;
  }
  h1 :global(span) {
    color: var(--pop-faint);
  }
  .tagline {
    margin: 0;
    max-width: 30rem;
    color: var(--pop-muted);
    font-size: var(--sl-text-base);
    line-height: 1.6;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1rem;
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius);
    background: var(--pop-bg);
    padding: 0.3rem 0.35rem 0.3rem 0.8rem;
    max-width: 100%;
  }
  .chip code {
    overflow-x: auto;
    white-space: nowrap;
    background: none;
    border: 0;
    padding: 0;
    color: var(--pop-text);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
  }
  .chip code span {
    color: var(--pop-faint);
  }
  .copy-btn {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--pop-muted);
    cursor: pointer;
  }
  .copy-btn:hover {
    background: var(--pop-panel);
    color: var(--pop-ink);
  }
  .copy-btn svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon-done,
  .copy-btn.done .icon-copy {
    display: none;
  }
  .copy-btn.done .icon-done {
    display: block;
  }
  .copied {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .stage {
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-xl);
    background: var(--pop-panel);
    padding: clamp(1rem, 4vw, 3.5rem);
  }
  .stage-inner {
    max-width: 44rem;
    margin: 0 auto;
  }
</style>
