---
/**
 * The home page's feature tiles. Each line restates what the README promises, no more.
 */
import { Icon } from "@astrojs/starlight/components";

const features = [
  {
    icon: "list-format",
    title: "Topic logs",
    text: "Every message gets a sequence number in its topic's log. Subscribers replay history, resume after a disconnect or a server restart, and spot duplicates.",
  },
  {
    icon: "random",
    title: "Durable sessions",
    text: "Name a session when you connect, and your subscriptions and acknowledgement positions survive disconnects and server restarts.",
  },
  {
    icon: "approve-check-circle",
    title: "QoS 0 and QoS 1",
    text: "QoS 1 is at-least-once per subscriber. A message that runs out of retries pauses that subscription, or goes to a dead-letter topic if you set one.",
  },
  {
    icon: "puzzle",
    title: "Wildcards and groups",
    text: "Subscribe to orders/# or sensors/+/temp, or share a topic across a group of workers so each message goes to one of them.",
  },
  {
    icon: "padlock",
    title: "Users and permissions",
    text: "Per-topic grants, Argon2id passwords, JWTs and rate limits. Change accounts on a running server, and live connections follow at once.",
  },
  {
    icon: "seti:json",
    title: "Four client libraries",
    text: "Rust, TypeScript, Python and Go handle login, reconnection, resubscription, acknowledgements and deduplication, each held to one shared scenario suite.",
  },
] as const;
---

<div class="grid not-content">
  {
    features.map((f) => (
      <article class="tile">
        <span class="icon">
          <Icon name={f.icon} size="1.25rem" />
        </span>
        <h3>{f.title}</h3>
        <p>{f.text}</p>
      </article>
    ))
  }
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-xl);
    background: var(--pop-border);
    gap: 1px;
  }
  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .tile {
    padding: 1.6rem 1.6rem 1.75rem;
    background: var(--pop-bg);
    transition: background-color 0.15s ease;
  }
  .tile:hover {
    background: var(--pop-panel);
  }
  .icon {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--pop-border);
    border-radius: 9px;
    background: var(--pop-panel);
    color: var(--pop-ink);
  }
  h3 {
    margin: 1.1rem 0 0.4rem;
    color: var(--pop-ink);
    font-family: var(--pop-font-display);
    font-size: 1rem;
    font-weight: 550;
    letter-spacing: -0.015em;
  }
  p {
    margin: 0;
    color: var(--pop-muted);
    font-size: var(--sl-text-sm);
    line-height: 1.6;
  }
</style>
