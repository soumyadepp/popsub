---
/**
 * A worker with a durable session runs, stops and starts again. While it is stopped, one known
 * topic gets a message and a new matching topic appears; on restart the session delivers both.
 */
const phases = [
  { label: "running", x: 130, w: 200 },
  { label: "stopped", x: 330, w: 200, shade: true },
  { label: "started again", x: 530, w: 220 },
];
const lanes = { a: 66, b: 118, worker: 204 };
const r = 13;
const messages = [
  { lane: "a", x: 200, seq: 1, arrive: 200 },
  { lane: "a", x: 425, seq: 2, arrive: 650 },
  { lane: "b", x: 395, seq: 1, arrive: 590 },
  { lane: "b", x: 470, seq: 2, arrive: 620 },
];
const laneY = (lane: string) => (lane === "a" ? lanes.a : lanes.b);
---

<figure class="diagram not-content">
  <div class="scroll">
    <svg viewBox="0 0 760 250" role="img" aria-labelledby="session-resume-title">
      <title id="session-resume-title">
        A worker subscribed to orders/# reads orders/42 message 1 and stops. While it is stopped,
        orders/42 gets message 2 and a new topic, orders/cli, gets messages 1 and 2. The server
        keeps the session's place: orders/42 read to 1. When the worker starts again it receives
        orders/cli 1 and 2 and orders/42 2.
      </title>

      {
        phases.map((p) => (
          <g>
            {p.shade && <rect class="shade" x={p.x} y="28" width={p.w} height="210" rx="8" />}
            <text class="phase" x={p.x + p.w / 2} y="18">{p.label}</text>
          </g>
        ))
      }

      <text class="lane-label" x="0" y={lanes.a + 4.5}>orders/42</text>
      <text class="lane-label" x="0" y={lanes.b + 4.5}>orders/cli</text>
      <text class="lane-label strong" x="0" y={lanes.worker + 4.5}>worker</text>

      <line class="lane" x1="130" x2="750" y1={lanes.a} y2={lanes.a} />
      <line class="lane absent" x1="130" x2="372" y1={lanes.b} y2={lanes.b} />
      <line class="lane" x1="372" x2="750" y1={lanes.b} y2={lanes.b} />
      <text class="tiny" x="372" y={lanes.b - 20}>created</text>
      <line class="tick" x1="372" x2="372" y1={lanes.b - 14} y2={lanes.b + 6} />

      {
        messages.map((m) => (
          <line class="delivery" x1={m.x} y1={laneY(m.lane) + r} x2={m.arrive} y2={lanes.worker - 7} />
        ))
      }
      {
        messages.map((m) => (
          <g class="msg">
            <circle cx={m.x} cy={laneY(m.lane)} r={r} />
            <text x={m.x} y={laneY(m.lane) + 4.5}>{m.seq}</text>
          </g>
        ))
      }

      <line class="worker" x1="130" x2="330" y1={lanes.worker} y2={lanes.worker} />
      <line class="worker" x1="530" x2="750" y1={lanes.worker} y2={lanes.worker} />
      {messages.map((m) => <circle class="arrival" cx={m.arrive} cy={lanes.worker} r="5.5" />)}

      <g class="store">
        <rect x="345" y={lanes.worker - 22} width="170" height="44" rx="6" />
        <text class="store-head" x="430" y={lanes.worker - 4}>server keeps the session</text>
        <text x="430" y={lanes.worker + 13}>orders/42: read to 1</text>
      </g>
    </svg>
  </div>
  <figcaption>
    The worker subscribes to <code>orders/#</code> with the session <code>orders-worker</code>.
    While it's stopped, <code>orders/42</code> gets message 2 and <code>orders/cli</code> is
    created. When it starts again it gets all three, each in order.
  </figcaption>
</figure>

<style>
  .diagram {
    margin: 1.75rem 0;
    padding: 1.25rem 1.25rem 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-7, var(--sl-color-black));
  }
  .scroll {
    overflow-x: auto;
  }
  svg {
    display: block;
    width: 100%;
    min-width: 34rem;
    height: auto;
    font-family: var(--sl-font-mono);
  }
  text {
    fill: var(--sl-color-gray-2);
    font-size: 14px;
  }
  .shade {
    fill: var(--sl-color-gray-6);
    opacity: 0.6;
  }
  .phase {
    text-anchor: middle;
    font-size: 12.5px;
    fill: var(--sl-color-gray-3);
  }
  .lane-label {
    fill: var(--sl-color-gray-2);
  }
  .strong {
    fill: var(--sl-color-white);
  }
  .lane {
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.5;
  }
  .absent {
    stroke: var(--sl-color-gray-5);
    stroke-dasharray: 2 4;
  }
  .tick {
    stroke: var(--sl-color-gray-4);
  }
  .tiny {
    font-size: 11.5px;
    fill: var(--sl-color-gray-3);
    text-anchor: middle;
  }
  .msg circle {
    fill: var(--sl-color-gray-6);
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.5;
  }
  .msg text {
    text-anchor: middle;
    fill: var(--sl-color-white);
    font-size: 13px;
  }
  .delivery {
    stroke: var(--pop-signal);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
  }
  .worker {
    stroke: var(--pop-signal);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .arrival {
    fill: var(--pop-signal);
  }
  .store rect {
    fill: var(--sl-color-bg);
    stroke: var(--pop-signal);
    stroke-width: 1.25;
  }
  .store text {
    text-anchor: middle;
    font-size: 12.5px;
    fill: var(--sl-color-white);
  }
  .store .store-head {
    font-size: 11px;
    fill: var(--sl-color-gray-3);
  }
  figcaption {
    margin-top: 0.9rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    line-height: 1.6;
  }
  figcaption code {
    font-size: 0.95em;
  }
</style>
