---
/**
 * The one project a reader makes for the Quickstart and keeps for every example, in the four
 * example languages. The file layout it describes matches the paths ExampleCode shows.
 */
import { Code, Tabs, TabItem } from "@astrojs/starlight/components";
---

<Tabs syncKey="lang">
  <TabItem label="TypeScript">
    <p>Node 22 or newer.</p>
    <Code
      lang="bash"
      code={`mkdir popsub-examples && cd popsub-examples
npm init -y
npm install popsub`}
    />
    <p>Save each program as the <code>.mjs</code> file named above its code.</p>
  </TabItem>
  <TabItem label="Python">
    <p>Python 3.10 or newer.</p>
    <Code
      lang="bash"
      code={`mkdir popsub-examples && cd popsub-examples
python3 -m venv .venv && source .venv/bin/activate
pip install popsub`}
    />
    <p>Save each program as the <code>.py</code> file named above its code.</p>
  </TabItem>
  <TabItem label="Go">
    <p>Go 1.23 or newer.</p>
    <Code
      lang="bash"
      code={`mkdir popsub-examples && cd popsub-examples
go mod init example.com/popsub-examples
go get github.com/soumyadepp/popsub/clients/go@latest`}
    />
    <p>Each program is a <code>main.go</code> in its own folder, such as <code>subscribe/main.go</code>.</p>
  </TabItem>
  <TabItem label="Rust">
    <p>Stable Rust.</p>
    <Code
      lang="bash"
      code={`cargo new popsub-examples && cd popsub-examples
cargo add popsub_sdk
cargo add tokio --features macros,rt-multi-thread,io-util,io-std,time`}
    />
    <p>Each program goes in <code>src/bin/</code>, such as <code>src/bin/subscribe.rs</code>.</p>
  </TabItem>
</Tabs>
